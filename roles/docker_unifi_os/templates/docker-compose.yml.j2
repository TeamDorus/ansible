---
version: "3"

services:

  unifi-os-server:
    image: ghcr.io/lemker/unifi-os-server:latest
    container_name: unifi-os-server
    cgroup: host
    cap_add:
      - NET_RAW
      - NET_ADMIN
    extra_hosts:
      host.docker.internal: host-gateway
    tmpfs:
      - /run:exec
      - /run/lock
      - /tmp:exec
      - /var/lib/journal
      - /var/opt/unifi/tmp:size=64m
    environment:
      - UOS_SYSTEM_IP=unifi-os.bartok.thouars.nl
    volumes:
      - /sys/fs/cgroup:/sys/fs/cgroup:rw
      - {{ unifi_volume_dir }}/persistent:/persistent
      - {{ unifi_volume_dir }}/var-log:/var/log
      - {{ unifi_volume_dir }}/data:/data
      - {{ unifi_volume_dir }}/srv:/srv
      - {{ unifi_volume_dir }}/var-lib-unifi:/var/lib/unifi
      - {{ unifi_volume_dir }}/var-lib-mongodb:/var/lib/mongodb
      - {{ unifi_volume_dir }}/etc-rabbitmq-ssl:/etc/rabbitmq/ssl
    ports:
      - 11443:443
      - 8080:8080
      - 3478:3478/udp
      - 10003:10003/udp
    restart: unless-stopped



  unifi-poller:
    container_name: unifi-poller
    image: golift/unifi-poller:2.0
    restart: unless-stopped
    environment:
    - UP_INFLUXDB_URL=http://olympos:8086
    - UP_INFLUXDB_DB=unifi
    - UP_INFLUXDB_USER=V1_Client
    - UP_INFLUXDB_PASS={{ influxdb2_v1_password }}
    - UP_UNIFI_DEFAULT_URL=https://192.168.55.20:8443
    - UP_UNIFI_DEFAULT_USER=unifipoller
    - UP_UNIFI_DEFAULT_PASS=UPw8woordathome
    - UP_INFLUXDB_INTERVAL=5m
    - TZ=Europe/Amsterdam
